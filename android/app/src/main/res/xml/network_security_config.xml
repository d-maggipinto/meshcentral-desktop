<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Certificates: the system store, plus certificates the user installed on the device
     (a MeshCentral server with its own self-generated certificate: install that certificate in Android's
     settings, then the app trusts it like a browser would). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
